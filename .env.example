# MongoDB Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/moderation?retryWrites=true&w=majority

# Backend Port
PORT=5000

# JSON Web Token Secret for Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# AWS Configuration (used by Express server to talk to S3 and SQS)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS S3 (for image uploads)
S3_BUCKET_NAME=your_s3_bucket_name

# AWS SQS (for async processing)
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/content-moderation-queue

# AWS SNS (for real-time high severity alerts)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:high-severity-moderation-alerts
